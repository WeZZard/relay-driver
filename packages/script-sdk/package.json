{
  "name": "@wezzard/relay-driver-script-sdk",
  "version": "0.1.0",
  "description": "Relay Driver script-side SDK: wrap individual tool calls from uploaded JavaScript, TypeScript, or Python scripts with recorded-call semantics.",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": "./dist/src/index.js"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WeZZard/relay-driver.git",
    "directory": "packages/script-sdk"
  },
  "homepage": "https://github.com/WeZZard/relay-driver/tree/main/packages/script-sdk#readme",
  "bugs": {
    "url": "https://github.com/WeZZard/relay-driver/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist/src",
    "bin"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test dist/test/*.test.js"
  },
  "dependencies": {
    "@wezzard/relay-driver-remote-runtime": "^0.1.0",
    "@wezzard/relay-driver-core": "^0.1.0"
  }
